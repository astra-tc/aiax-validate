{
  "name": "aiax-validate",
  "version": "0.1.0",
  "description": "Validate and score any site's AIAX manifest and its sections against the AIAX 0.1 schemas",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "coverage": "c8 --reporter=text --include=src node --import tsx --test test/*.test.ts",
    "mutation": "node scripts/mutation-check.mjs"
  },
  "keywords": [],
  "author": "Astra Trading Co",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "types": "dist/index.d.ts",
  "bin": {
    "aiax-validate": "dist/bin.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/astra-tc/aiax-validate"
  }
}